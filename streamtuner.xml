<?xml version="1.0"?>
<Container version="2">
  <Name>streamtuner</Name>
  <Repository>ghcr.io/meminiau/streamtuner:latest</Repository>
  <Registry>https://github.com/meminiau/streamtuner/pkgs/container/streamtuner</Registry>
  <Network>bridge</Network>
  <Privileged>false</Privileged>
  <Support>https://github.com/meminiau/streamtuner/issues</Support>
  <Project>https://github.com/meminiau/streamtuner</Project>
  <Overview>Lightweight IPTV tuner proxy and HDHomeRun emulator for Unraid, Jellyfin, and Plex.</Overview>
  <Category>MediaApp:Video MediaServer:Video</Category>
  <WebUI>http://[IP]:[PORT:7070]/discover.json</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/meminiau/streamtuner/main/streamtuner.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/meminiau/streamtuner/main/icon.png</Icon>
  <Description>Lightweight IPTV tuner proxy and HDHomeRun emulator designed to eliminate buffer drops on live Free-to-Air streams.</Description>
  <Networking>
    <Mode>bridge</Mode>
    <Publish>
      <Port>
        <HostPort>7070</HostPort>
        <ContainerPort>8080</ContainerPort>
        <Protocol>tcp</Protocol>
      </Port>
    </Publish>
  </Networking>
  <Config Name="Web Port" Target="8080" Default="7070" Mode="tcp" Description="Web interface &amp; HDHomeRun discovery port" Type="Port" Display="always" Required="true" Mask="false">7070</Config>
</Container>
